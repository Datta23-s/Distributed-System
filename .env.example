# UrbanPulse Dispatch Environment Template (.env.example)

# Database Connection (SQLite for local dev, PostgreSQL for production docker)
# Local SQLite:
DATABASE_URL="file:./dev.db"
# Production PostgreSQL:
# DATABASE_URL="postgresql://urbanpulse:urbanpulse_secure_pass@localhost:5432/urbanpulse_db?schema=public"

# Gateway Configuration
PORT=5000
NODE_ENV=production

# JWT Token Secret (Generate a strong random 256-bit string)
JWT_SECRET="replace-with-a-secure-random-secret-for-production"

# Geographic Service Area (Pune, MH)
SERVICE_CITY="Pune"
SERVICE_STATE="Maharashtra"
SERVICE_COUNTRY="India"
DEFAULT_CURRENCY="INR"
PUNE_CENTER_LAT=18.5204
PUNE_CENTER_LNG=73.8567

# External Integrations (Optional)
# Geocoding / Routing Provider:
# OSRM_ROUTING_URL="https://router.project-osrm.org"
# Payment Sandbox:
# RAZORPAY_KEY_ID="rzp_test_placeholder"
# RAZORPAY_KEY_SECRET="placeholder_secret"
